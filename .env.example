# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING_FOR_REFRESH_TOKEN
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MFA_CHALLENGE_TTL_MINUTES=5
TRUSTED_DEVICE_TTL_DAYS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voter_management

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MFA encryption
MFA_SECRET_ENCRYPTION_KEY=replace-me-with-32-byte-key
MFA_ISSUER=Voter Management System

# Seed defaults
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
